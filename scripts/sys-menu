#!/bin/bash

menu() {
  local prompt="$1"
  local options="$2"
  echo -e "$options" | walker --dmenu --width 295 --minheight 1 --maxheight 630 -p "$prompt…" 2>/dev/null
}

confirm() {
  [[ $(menu "Confirm" "  Yes\n  No") == *Yes* ]]
}

present_terminal() {
  ghostty -e bash -c "$1; read -p 'Press enter to close...'"
}

show_main_menu() {
  case $(menu "Go" "󰀻  Apps\n󰧑  Learn\n󰄀  Capture\n󱓞  Toggle\n  Style\n󰒓  Setup\n  Configs\n󰉉  Install\n󰭌  Remove\n  Update\n󱂬  Workspaces\n⏻  System") in
  *Apps*)    walker -p "Launch…" ;;
  *Learn*)   show_learn_menu ;;
  *Capture*) show_capture_menu ;;
  *Toggle*)  show_toggle_menu ;;
  *Style*)   show_style_menu ;;
  *Setup*)   show_setup_menu ;;
  *Configs*) show_configs_menu ;;
  *Install*) show_install_menu ;;
  *Remove*)  show_remove_menu ;;
  *Update*)  show_update_menu ;;
  *Workspaces*) show_workspaces_menu ;;
  *System*)  show_system_menu ;;
  esac
}

show_learn_menu() {
  case $(menu "Learn" "  Keybindings\n  CachyOS Wiki\n  Hyprland Wiki\n󰣇  Arch Wiki\n  Neovim Docs\n󱆃  Bash Manual") in
  *Keybindings*) /home/felix/.local/bin/keybindings ;;
  *CachyOS*)     xdg-open https://wiki.cachyos.org/ ;;
  *Hyprland*)    xdg-open https://wiki.hypr.land ;;
  *Arch*)        xdg-open https://wiki.archlinux.org ;;
  *Neovim*)      xdg-open https://neovim.io/doc/ ;;
  *Bash*)        xdg-open https://www.gnu.org/software/bash/manual/ ;;
  *) show_main_menu ;;
  esac
}

show_capture_menu() {
  case $(menu "Capture" "󰹑  Screenshot\n  Screen Recording\n󰈊  Color Picker\n󱄺  OCR Text") in
  *Screenshot*) grimblast copysave area ;;
  *Recording*)  wf-recorder -f ~/Videos/recording.mp4 ;;
  *Color*)      hyprpicker -a ;;
  *OCR*)        grim -g "$(slurp)" - | tesseract stdin stdout | wl-copy ;;
  *) show_main_menu ;;
  esac
}

show_toggle_menu() {
  case $(menu "Toggle" "󰍜  Waybar\n󱩫  Screen Shader\n󰔟  Idle Timeout\n  Hardware") in
  *Waybar*) pkill -USR1 waybar ;;
  *Shader*) pkill wlsunset || wlsunset -t 4500 ;;
  *Idle*)   pkill hypridle || hypridle ;;
  *Hardware*) show_hardware_menu ;;
  *) show_main_menu ;;
  esac
}

show_hardware_menu() {
  case $(menu "Hardware" "󰟸  Trackpad") in
  *Trackpad*) toggle_trackpad ;;
  *) show_toggle_menu ;;
  esac
}

toggle_trackpad() {
  local status_file="/tmp/hypr-trackpad-disabled"
  local device_name
  device_name=$(hyprctl devices -j | jq -r '.mice[] | select(.name | test("trackpad"; "i")) | .name' | head -1)

  if [[ -z "$device_name" ]]; then
    notify-send -u critical "Trackpad toggle" "No trackpad device found"
    return
  fi

  if [[ -f "$status_file" ]]; then
    hyprctl eval "hl.device({ name = '$device_name', enabled = true })"
    rm -f "$status_file"
    notify-send -u low "Trackpad enabled"
  else
    hyprctl eval "hl.device({ name = '$device_name', enabled = false })"
    touch "$status_file"
    notify-send -u low "Trackpad disabled"
  fi
}

show_style_menu() {
  case $(menu "Style" "󰸌  Edit Theme\n󰛖  Font\n󰸉  Background\n󰍜  Waybar Position\n  Config") in
  "*Edit Theme*")   ghostty -e bash -c 'nvim ~/.config/theme/colors.sh && sync-theme' ;;
  *Font*)         show_font_menu ;;
  *Background*)   show_background_menu ;;
  *Waybar*)       show_waybar_position_menu ;;
  *Config*)       ghostty -e nvim /home/felix/.config/hypr/hyprland.lua ;;
  *) show_main_menu ;;
  esac
}

show_font_menu() {
  local fonts current chosen
  fonts=$(fc-list :spacing=100 -f "%{family[0]}\n" | grep -v -i -E 'emoji|signwriting' | sort -u)
  current=$(grep 'font-family' ~/.config/waybar/style.css | head -1 | sed "s/.*'\(.*\)'.*/\1/")
  chosen=$(echo "$fonts" | walker --dmenu --width 400 --minheight 1 --maxheight 630 -p "Font (current: $current)…" 2>/dev/null)
  if [[ -n $chosen ]]; then
    sed -i "s/font-family = .*/font-family = \"$chosen\"/" ~/.config/ghostty/config.ghostty
    sed -i "s/font-family: .*/font-family: '$chosen';/g" ~/.config/waybar/style.css
    pkill waybar; waybar & disown
    notify-send -u low "Font set to $chosen"
  else
    show_style_menu
  fi
}

show_background_menu() {
  local chosen
  chosen=$(find ~/.local/share/wallpapers/custom-wallpapers/ -type f 2>/dev/null | walker --dmenu --width 500 --minheight 1 --maxheight 630 -p "Wallpaper…" 2>/dev/null)
  if [[ -n $chosen ]]; then
    sed -i "s|path = .*|path = $chosen|" ~/.config/hypr/hyprpaper.conf
    hyprctl hyprpaper wallpaper ",$chosen" 2>/dev/null || { pkill hyprpaper; hyprpaper & disown; }
    notify-send -u low "Wallpaper set"
  else
    show_style_menu
  fi
}

show_waybar_position_menu() {
  case $(menu "Waybar Position" "󰁝  Top\n󰁅  Bottom") in
  *Top*)
    sed -i 's/"position": "bottom"/"position": "top"/' ~/.config/waybar/config.jsonc
    pkill waybar; waybar & disown ;;
  *Bottom*)
    sed -i 's/"position": "top"/"position": "bottom"/' ~/.config/waybar/config.jsonc
    pkill waybar; waybar & disown ;;
  *) show_style_menu ;;
  esac
}

show_setup_menu() {
  case $(menu "Setup" "  Audio\n  Wi-Fi\n󰂯  Bluetooth\n󰈆  Default Apps") in
  *Audio*)   ghostty -e pulsemixer ;;
  *Wi-Fi*)   ghostty -e nmtui ;;
  *Bluetooth*) ghostty -e bluetuith ;;
  *Default*) ghostty -e nvim ~/.config/mimeapps.list ;;
  *) show_main_menu ;;
  esac
}

show_configs_menu() {
  case $(menu "Configs" "  Hyprland\n󰍜  Walker\n󰍜  Waybar\n󰎟  Mako\n  Ghostty\n󰮫  Sys Menu\n  Dotfiles") in
  *Hyprland*) ghostty -e nvim ~/.config/hypr/hyprland.lua ;;
  *Walker*)   ghostty -e nvim ~/.config/walker/config.toml ;;
  *Waybar*)   ghostty -e nvim ~/.config/waybar/config.jsonc ;;
  *Mako*)     ghostty -e nvim ~/.config/mako/config ;;
  *Ghostty*)  ghostty -e nvim ~/.config/ghostty/config.ghostty ;;
  *Sys*)      ghostty -e nvim ~/.local/bin/sys-menu ;;
  *Dotfiles*) show_dotfiles_menu ;;
  *) show_main_menu ;;
  esac
}

show_dotfiles_menu() {
  case $(menu "Dotfiles" "  Save\n󰓦  Sync") in
  *Save*) present_terminal "dotfiles-save" ;;
  *Sync*) present_terminal "dotfiles-sync" ;;
  *) show_configs_menu ;;
  esac
}

show_install_menu() {
  case $(menu "Install" "󰣇  Package\n󰣇  AUR\n󰖟  Browser\n  Terminal\n󰵮  Development\n󰖟  Web App") in
  *Package*)     show_pkg_install ;;
  *AUR*)         show_aur_install ;;
  *Browser*)     show_install_browser_menu ;;
  *Terminal*)    show_install_terminal_menu ;;
  *Development*) show_install_dev_menu ;;
  *"Web App"*)   install_webapp ;;
  *) show_main_menu ;;
  esac
}

install_webapp() {
  local name url slug domain profile_dir icon_dir icon_path
  name=$(menu "Web App Name" "")
  [[ -z $name ]] && { show_install_menu; return; }
  url=$(menu "Web App URL" "")
  [[ -z $url ]] && { show_install_menu; return; }
  [[ $url != http://* && $url != https://* ]] && url="https://$url"
  slug=$(echo "$name" | tr "[:upper:] " "[:lower:]-" | tr -cd "[:alnum:]-")
  domain=$(echo "$url" | sed -E "s#^https?://##; s#/.*##")
  profile_dir="/home/felix/.local/share/webapp-profiles/${slug}"
  icon_dir="/home/felix/.local/share/icons/webapps"
  icon_path="${icon_dir}/${slug}.png"
  mkdir -p "$profile_dir" "$icon_dir"
  curl -sL "https://www.google.com/s2/favicons?sz=128&domain=${domain}" -o "$icon_path"
  cat > "/home/felix/.local/share/applications/webapp-${slug}.desktop" << DESKTOP
[Desktop Entry]
Name=$name
Exec=chromium --app="$url" --user-data-dir="$profile_dir" --class=webapp-${slug}
Icon=$icon_path
Type=Application
Categories=Network;
StartupWMClass=webapp-${slug}
DESKTOP
  notify-send -u low "Web App Installed" "$name"
}

show_pkg_install() {
  ghostty -e bash -c '
    pkg_names=$(pacman -Slq | fzf \
      --multi \
      --preview "pacman -Sii {1}" \
      --preview-label="alt-p: toggle, tab: multi-select" \
      --preview-label-pos=bottom \
      --preview-window "down:65%:wrap" \
      --bind "alt-p:toggle-preview" \
      --bind "alt-d:preview-half-page-down,alt-u:preview-half-page-up" \
      --bind "alt-k:preview-up,alt-j:preview-down" \
      --color "pointer:green,marker:green")
    if [[ -n $pkg_names ]]; then
      echo "$pkg_names" | tr "\n" " " | xargs -o sudo pacman -S
    fi
  '
}

show_aur_install() {
  ghostty -e bash -c '
    pkg_names=$(yay -Slq | fzf \
      --multi \
      --preview "yay -Sii {1}" \
      --preview-label="alt-p: toggle, tab: multi-select" \
      --preview-label-pos=bottom \
      --preview-window "down:65%:wrap" \
      --bind "alt-p:toggle-preview" \
      --bind "alt-d:preview-half-page-down,alt-u:preview-half-page-up" \
      --bind "alt-k:preview-up,alt-j:preview-down" \
      --color "pointer:green,marker:green")
    if [[ -n $pkg_names ]]; then
      echo "$pkg_names" | tr "\n" " " | xargs -o yay -S
    fi
  '
}

show_install_browser_menu() {
  case $(menu "Install Browser" "󰖟  Zen\n󰈹  Firefox\n  Chrome") in
  *Zen*)     present_terminal "yay -S zen-browser-bin" ;;
  *Firefox*) present_terminal "sudo pacman -S firefox" ;;
  *Chrome*)  present_terminal "yay -S google-chrome" ;;
  *) show_install_menu ;;
  esac
}

show_install_terminal_menu() {
  case $(menu "Install Terminal" "  Ghostty\n  Kitty\n  Foot") in
  *Ghostty*) present_terminal "yay -S ghostty" ;;
  *Kitty*)   present_terminal "sudo pacman -S kitty" ;;
  *Foot*)    present_terminal "sudo pacman -S foot" ;;
  *) show_install_menu ;;
  esac
}

show_install_dev_menu() {
  case $(menu "Install Dev" "  Node.js\n  Python\n  Rust\n󰟓  Go\n  Docker") in
  *Node*)   present_terminal "sudo pacman -S nodejs npm" ;;
  *Python*) present_terminal "sudo pacman -S python python-pipx" ;;
  *Rust*)   present_terminal "sudo pacman -S rustup && rustup default stable" ;;
  *Go*)     present_terminal "sudo pacman -S go" ;;
  *Docker*) present_terminal "sudo pacman -S docker docker-compose && sudo systemctl enable --now docker" ;;
  *) show_install_menu ;;
  esac
}

show_remove_menu() {
  case $(menu "Remove" "  Package\n󰖟  Web App") in
  *Package*)   remove_pkg ;;
  *"Web App"*) remove_webapp ;;
  *) show_main_menu ;;
  esac
}

remove_pkg() {
  ghostty -e bash -c '
    pkg_names=$(yay -Qqe | fzf \
      --multi \
      --preview "yay -Qi {1}" \
      --preview-label="alt-p: toggle, tab: multi-select" \
      --preview-label-pos=bottom \
      --preview-window "down:65%:wrap" \
      --bind "alt-p:toggle-preview" \
      --bind "alt-d:preview-half-page-down,alt-u:preview-half-page-up" \
      --bind "alt-k:preview-up,alt-j:preview-down" \
      --color "pointer:red,marker:red")
    if [[ -n $pkg_names ]]; then
      echo "$pkg_names" | tr "\n" " " | xargs -o sudo pacman -Rns
    fi
  '
}

remove_webapp() {
  local files opts chosen f
  files=(/home/felix/.local/share/applications/webapp-*.desktop)
  if [[ ! -e ${files[0]} ]]; then
    notify-send -u low "Remove Web App" "No web apps installed"
    show_remove_menu
    return
  fi
  opts=$(for f in "${files[@]}"; do grep "^Name=" "$f" | sed "s/^Name=//"; done)
  chosen=$(menu "Remove Web App" "$opts")
  [[ -z $chosen ]] && { show_remove_menu; return; }
  for f in "${files[@]}"; do
    if [[ $(grep "^Name=" "$f" | sed "s/^Name=//") == "$chosen" ]]; then
      local wm_slug
      wm_slug=$(grep "^StartupWMClass=webapp-" "$f" | sed "s/^StartupWMClass=webapp-//")
      rm -f "$f"
      rm -rf "/home/felix/.local/share/webapp-profiles/${wm_slug}"
      rm -f "/home/felix/.local/share/icons/webapps/${wm_slug}.png"
      notify-send -u low "Web App Removed" "$chosen"
      break
    fi
  done
}

show_update_menu() {
  case $(menu "Update" "  System Packages") in
  *System*) present_terminal "yay -Syu" ;;
  *) show_main_menu ;;
  esac
}

declare -A WORKSPACE_NAMES=(
  [1]="󰖟  Web"
  [2]="󰙯  Discord"
  [3]="󰊗  Gaming"
  [4]="󰐌  OBS"
  [5]="  Music"
  [6]="  Desktop"
  [7]="󰅗  Background"
)

ws_label() {
  local id="$1"
  echo "${id}: ${WORKSPACE_NAMES[$id]:-Workspace $id}"
}

ws_id_from_label() {
  echo "$1" | cut -d: -f1 | tr -d '[:space:]'
}

declare -A MONITOR_NAMES=(
  [eDP-1]="Laptop"
  [DP-2]="Monitor"
)

monitor_label() {
  local name="$1"
  echo "${MONITOR_NAMES[$name]:-$name}: $name"
}

monitor_name_from_label() {
  echo "$1" | rev | cut -d: -f1 | rev | tr -d '[:space:]'
}

show_workspaces_menu() {
 case $(menu "Workspaces" "󰒓  Presets\n󰓡  Swap Workspaces\n󰆾  Move Workspace") in
  *Presets*) show_workspaces_presets ;;
  *Swap*)    show_workspaces_swap ;;
  *Move*)    show_workspaces_move ;;
  *)         show_main_menu ;;
  esac
}

show_workspaces_presets() {
  case $(menu "Presets" "󰊗  Controller Gaming\n󰕮  Default Layout") in
  *Controller*)
    # Move Discord to laptop, Gaming to 2nd monitor
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = 2, monitor = 'eDP-1'})"
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = 3, monitor = 'DP-2'})"
    # Focus them so they display on screen
    hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = 2 }))'
    hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = 3 }))'
    notify-send -u low "Preset Activated" "Controller Gaming Mode"
    ;;
  *Default*)
    # Put everything back to normal baseline
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = 1, monitor = 'DP-2'})"
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = 2, monitor = 'DP-2'})"
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = 3, monitor = 'eDP-1'})"
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = 4, monitor = 'eDP-1'})"
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = 5, monitor = 'eDP-1'})"
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = 6, monitor = 'eDP-1'})"
    # Focus default active screens
    hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = 1 }))'
    hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = 6 }))'
    notify-send -u low "Preset Activated" "Default Layout Restored"
    ;;
  *) show_workspaces_menu ;;
  esac
}

show_workspaces_swap() {
  local ws1 ws2 mon1 mon2 allowed_ws ws_list label_list ws1_choice ws2_choice

  ws_list=$(hyprctl workspaces -j | jq -r '.[].id' | sort -n)
  label_list=$(for id in $ws_list; do ws_label "$id"; done)

  ws1_choice=$(menu "Select first workspace" "$label_list")
  [[ -z $ws1_choice ]] && { show_workspaces_menu; return; }
  ws1=$(ws_id_from_label "$ws1_choice")

  mon1=$(hyprctl workspaces -j | jq -r ".[] | select(.id == $ws1) | .monitor")

  allowed_ws=$(hyprctl workspaces -j | jq -r ".[] | select(.monitor != \"$mon1\") | .id" | sort -n)

  if [[ -z $allowed_ws ]]; then
    notify-send -u critical "Swap Workspaces" "No active workspaces found on other monitors to swap with."
    show_workspaces_menu
    return
  fi

  label_list=$(for id in $allowed_ws; do ws_label "$id"; done)
  ws2_choice=$(menu "Swap $(ws_label "$ws1") with" "$label_list")
  [[ -z $ws2_choice ]] && { show_workspaces_menu; return; }
  ws2=$(ws_id_from_label "$ws2_choice")

  mon2=$(hyprctl workspaces -j | jq -r ".[] | select(.id == $ws2) | .monitor")

  hyprctl dispatch "hl.dsp.workspace.move({ workspace = $ws1, monitor = '"'"'$mon2'"'"'})"
  hyprctl dispatch "hl.dsp.workspace.move({ workspace = $ws2, monitor = '"'"'$mon1'"'"'})"

  hyprctl eval "hl.dispatch(hl.dsp.focus({ workspace = $ws1 }))"
  hyprctl eval "hl.dispatch(hl.dsp.focus({ workspace = $ws2 }))"

  notify-send -u low "Workspaces Swapped" "$(ws_label "$ws1") <-> $(ws_label "$ws2")"
}

show_workspaces_move() {
  local ws_ids label_list ws_choice ws
  ws_ids="1 2 3 4 5 6 7"
  label_list=$(for id in $ws_ids; do ws_label "$id"; done)
  ws_choice=$(menu "Select Workspace" "$label_list")
  if [[ -n $ws_choice ]]; then
    ws=$(ws_id_from_label "$ws_choice")
    show_monitor_menu_for_workspace_move "$ws"
  else
    show_workspaces_menu
  fi
}

show_monitor_menu_for_workspace_move() {
  local workspace="$1"
  local monitor_list label_list monitor_choice monitor_name

  monitor_list=$(hyprctl monitors -j | jq -r '.[].name')
  label_list=$(for m in $monitor_list; do monitor_label "$m"; done)
  monitor_choice=$(menu "Move workspace $workspace to…" "$label_list")

  if [[ -n $monitor_choice ]]; then
    monitor_name=$(monitor_name_from_label "$monitor_choice")
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = $workspace, monitor = '$monitor_name'})"
    hyprctl eval "hl.dispatch(hl.dsp.focus({ workspace = $workspace }))"
    notify-send -u low "Workspace $workspace" "Moved to $(monitor_label "$monitor_name") (until reload)"
  else
    show_workspaces_move
  fi
}

show_system_menu() {
  case $(menu "System" "  Screensaver\n  Lock\n󰍃  Logout\n󰒲  Suspend\n  Reboot\n󰐥  Shutdown") in
  *Screensaver*) /home/felix/.config/screensaver/omarchy-launch-screensaver ;;
  *Lock*)        hyprlock ;;
  *Logout*)      confirm && hyprctl dispatch exit ;;
  *Suspend*)     systemctl suspend ;;
  *Reboot*)      confirm && systemctl reboot ;;
  *Shutdown*)    confirm && systemctl poweroff ;;
  *)             show_main_menu ;;
  esac
}

show_main_menu
